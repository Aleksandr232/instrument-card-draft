# Ключ не храните в коде и не коммитьте .env
# Локальный OpenAI-совместимый API (llama-server из npm run ai)
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=qwen2.5-1.5b-instruct
PORT=3000

# Облачная модель вместо локальной:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
